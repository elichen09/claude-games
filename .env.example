# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Turns on the Claude judge (rules on answers that aren't on a game's answer board).
# Without it the site still works; off-board answers just don't count.
ANTHROPIC_API_KEY=

# Optional: which Claude model the judge uses. A small, fast model is plenty.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: your production URL, used for share links and social previews.
NEXT_PUBLIC_SITE_URL=https://offbeat-arcade.vercel.app
