# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Decision Room keeps rooms and ballots in a shared store so every judge's phone sees the same round.
# Add an Upstash Redis (Vercel → Storage → Upstash/KV) and these are filled in for you.
# Without them, rounds live in server memory: fine locally, unreliable on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Decision Room moderator passcode (defaults to eli123).
DECISION_ROOM_PASSCODE=

# Optional: your production URL, used for share links and social previews.
NEXT_PUBLIC_SITE_URL=https://offbeat-arcade.vercel.app
